<div class="container">
  <h1>New game</h1>

  <div class="letters">
    <% @letters.each do |item| %>
      <span class="letter"><%= item %></span>
    <% end %>
  </div>

  <p>What is the longest word you can find?</p>

  <form action="score" method="POST" data-turbo="false">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= hidden_field_tag :letters, @letters.join(" ") %>

    <div class="d-flex">
      <input class="form-control" type="text" id="word" name="word">
      <input class="btn btn-primary" type="submit" value="Play">
    </div>
  </form>
</div>
